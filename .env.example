# Injected by Vercel when a Blob store is connected to the project.
# VERCEL_OIDC_TOKEN is provided automatically on Vercel and is not listed here.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Shared password for /upload. Checked only on the server.
UPLOAD_PASSWORD=

# Server-only key for the viewer chat.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=
